<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="top">

        <!-- Número de paso -->
        <TextView
            android:id="@+id/tvStepNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_step_number"
            android:gravity="center"
            android:text="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginEnd="12dp" />

        <!-- Texto del paso -->
        <TextView
            android:id="@+id/tvStepText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Descripción del paso..."
            android:textSize="15sp"
            android:textColor="@color/hip_text_primary"
            android:lineSpacingMultiplier="1.3" />

        <!-- Botón check (marcar completado) -->
        <View
            android:id="@+id/btnCheckStep"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_check_step"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
