<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hip_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Tu menú del día"
        app:titleTextColor="@android:color/white"
        android:background="@color/hip_green" />

    <!-- Loading state -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="@color/hip_green"
            android:visibility="visible" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscando recetas..."
            android:textSize="16sp"
            android:textColor="@color/hip_text_secondary"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Summary nutricional del menú -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNutritionalSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/hip_green_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvTotalCalories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="— kcal total"
                android:textSize="13sp"
                android:textColor="@color/hip_green_dark"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvTotalProtein"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="— g proteína"
                android:textSize="13sp"
                android:textColor="@color/hip_green_dark"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvNutritionalScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Puntuación: —/10"
                android:textSize="13sp"
                android:textColor="@color/hip_green_dark"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Estado vacío -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNoRecipes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😕"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/tvNoRecipesHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No encontramos recetas compatibles.\nAgregá más ingredientes o revisá tu perfil."
            android:textSize="15sp"
            android:textColor="@color/hip_text_secondary"
            android:gravity="center"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- Lista de recetas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/hip_surface"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditIngredients"
            style="@style/Widget.HIP.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="✏ Editar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanNew"
            style="@style/Widget.HIP.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:text="📷 Nuevo escaneo" />
    </LinearLayout>

</LinearLayout>
