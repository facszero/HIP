<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Vista de la cámara -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay de guía visual -->
    <com.hip.ui.scan.ScanOverlayView
        android:id="@+id/scanOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Panel superior: info del paso -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:padding="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="@android:color/white"
                android:contentDescription="Volver" />

            <TextView
                android:id="@+id/tvStepCounter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paso 1 de 3"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btnAddManual"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                android:tint="@android:color/white"
                android:contentDescription="Agregar manualmente" />
        </LinearLayout>

        <!-- Progress bar de pasos -->
        <ProgressBar
            android:id="@+id/progressStep"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progressTint="@color/hip_green"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto general"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abrí la heladera y capturá el interior completo"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Hint de overlay (centro-bajo del área de cámara) -->
    <TextView
        android:id="@+id/tvOverlayHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:background="#66000000"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="visible" />

    <!-- Panel inferior: acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Status de análisis -->
        <ProgressBar
            android:id="@+id/progressAnalysis"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:visibility="gone"
            android:indeterminateTint="@color/hip_green" />

        <TextView
            android:id="@+id/tvAnalysisStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/hip_green"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Botón de captura -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp">

            <!-- Anillo exterior -->
            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_capture_ring" />

            <!-- Botón interno -->
            <Button
                android:id="@+id/btnCapture"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_capture_button"
                android:text="" />
        </FrameLayout>

        <Button
            android:id="@+id/btnSkipStep"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saltear"
            android:textColor="#AAFFFFFF" />
    </LinearLayout>

</FrameLayout>
