<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hip_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mi perfil nutricional"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/hip_text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Las recetas se adaptarán a tus necesidades"
            android:textSize="14sp"
            android:textColor="@color/hip_text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- Objetivo nutricional -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎯 Objetivo nutricional" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            android:layout_marginBottom="20dp" />

        <!-- Nivel de cocina -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="👨‍🍳 Nivel de cocina" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            android:layout_marginBottom="20dp" />

        <!-- Alergias e intolerancias -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚠ Alergias e intolerancias" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Las recetas con estos ingredientes no se mostrarán"
            android:textSize="13sp" android:textColor="@color/hip_text_secondary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupAllergies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            android:layout_marginBottom="20dp" />

        <!-- Equipamiento disponible -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🍳 Equipamiento disponible" android:textStyle="bold" android:textSize="16sp"
            android:layout_marginBottom="10dp" />

        <CheckBox android:id="@+id/checkHasOven" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Tengo horno"
            android:checked="true" android:textSize="15sp" />

        <CheckBox android:id="@+id/checkHasMicrowave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Tengo microondas"
            android:checked="true" android:textSize="15sp" />

        <CheckBox android:id="@+id/checkHasBlender" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Tengo licuadora/procesadora"
            android:textSize="15sp" android:layout_marginBottom="20dp" />

        <!-- Tiempo máximo de cocina -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⏱ Tiempo máximo que quiero cocinar" android:textStyle="bold"
            android:textSize="16sp" android:layout_marginBottom="8dp" />

        <SeekBar
            android:id="@+id/seekBarTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:thumbTint="@color/hip_green"
            android:progressTint="@color/hip_green"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTimeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Máx 60 min"
            android:textSize="14sp"
            android:textColor="@color/hip_text_secondary"
            android:layout_marginBottom="32dp" />

        <!-- Botones -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            style="@style/Widget.HIP.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar y continuar"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipProfile"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Omitir por ahora"
            android:textColor="@color/hip_text_secondary" />

    </LinearLayout>

</ScrollView>
