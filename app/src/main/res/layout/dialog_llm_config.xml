<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="La IA adapta los pasos de la receta a tus ingredientes exactos.\n\nNota de privacidad: Solo se envían nombres de ingredientes (texto), nunca imágenes."
        android:textSize="13sp"
        android:textColor="@color/hip_text_secondary"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Habilitar adaptación IA"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/switchLLMEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="API Key de OpenAI (opcional)"
        android:textSize="13sp"
        android:textColor="@color/hip_text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="sk-..."
        android:inputType="textPassword"
        android:fontFamily="monospace" />

</LinearLayout>
